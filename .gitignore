# Environment
# Any env file is ignored, not only the exact `.env` name, so a tool that
# writes a variant (`.env.local`, `.env.production`, …) cannot leak secrets
# into the repository by accident. The example file stays versioned on purpose.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Node
node_modules/
dist/

# Playwright
playwright-report/
test-results/
coverage/

# Eval data
# pliegos/ are real PDFs (large, downloaded by hand) — not versioned.
evals/pliegos/

# OS
.DS_Store
Thumbs.db
